# PostHog (browser)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Google Analytics 4 via gtag
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Microsoft Clarity project id (loads clarity.ms script)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional: Sentry browser DSN/environment
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Optional: link to a saved PostHog funnel / insight for intent_to_click_rate
NEXT_PUBLIC_POSTHOG_INTENT_INSIGHT_URL=
